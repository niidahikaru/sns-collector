{
  "manifest_version": 3,
  "name": "Threads投稿収集",
  "version": "2.0.0",
  "description": "Threads / X の投稿を収集してGoogle スプレッドシートに送信",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Threads投稿収集"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.net/*",
        "https://www.threads.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}